{
	"schemaVersion": 1,
	"id": "modernminecarts",
	"version": "${version}",
	"name": "ModernMinecarts",
	"description": "Expands minecart transport with faster rails, linked trains, furnace engines, cargo routing, crossings, jumps, and powered detectors.",
	"authors": [
		"LordKipama"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/modernminecarts/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
		"net.lordkipama.modernminecarts.ModernMinecartsClient"
	],
		"main": [
			"net.lordkipama.modernminecarts.ModernMinecarts"
		],
		"fabric-datagen": [
			"net.lordkipama.modernminecarts.ModernMinecartsDataGenerator"
		]
	},
	"mixins": [
		"modernminecarts.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.7",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
