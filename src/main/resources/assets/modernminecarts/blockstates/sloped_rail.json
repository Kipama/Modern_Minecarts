{
  "multipart": [
    {
      "when": {
        "shape": "ascending_east"
      },
      "apply": {
        "model": "modernminecarts:block/sloped_rail_raised_ne",
        "y": 90
      }
    },
    {
      "when": {
        "shape": "ascending_north"
      },
      "apply": {
        "model": "modernminecarts:block/sloped_rail_raised_ne"
      }
    },
    {
      "when": {
        "shape": "ascending_south"
      },
      "apply": {
        "model": "modernminecarts:block/sloped_rail_raised_sw"
      }
    },
    {
      "when": {
        "shape": "ascending_west"
      },
      "apply": {
        "model": "modernminecarts:block/sloped_rail_raised_sw",
        "y": 90
      }
    },
    {
      "when": {
        "shape": "east_west"
      },
      "apply": {
        "model": "modernminecarts:block/sloped_rail",
        "y": 90
      }
    },
    {
      "when": {
        "shape": "north_south"
      },
      "apply": {
        "model": "modernminecarts:block/sloped_rail"
      }
    }
  ]
}
